  "components": [
    {
      "name": "POC 主行动",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "联系团队开展 POC 的主要行动。",
      "html": "<a class=\"ds-primary\" href=\"#poc\">申请 POC <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-primary{font-family:\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:12px 20px;min-height:46px;background:var(--f-action,#0052d9);color:#fff;text-decoration:none;border:0;border-radius:6px;font-size:15px;font-weight:500;transition:background .2s}.ds-primary:hover{background:var(--f-action-hover,#366ef4)}.ds-primary:focus-visible{outline:2px solid var(--f-accent,#0052d9);outline-offset:5px}"
    },
    {
      "name": "次行动",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "继续阅读产品内容的低强调行动。",
      "html": "<a class=\"ds-secondary\" href=\"#guide\">了解企业接入 <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-secondary{font-family:\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif;display:inline-flex;align-items:center;gap:14px;padding:12px 20px;min-height:46px;border:1px solid var(--f-line,#ddd);border-radius:6px;background:var(--f-surface,#fff);color:var(--f-text,#191919);font-size:15px;text-decoration:none;transition:background .2s}.ds-secondary:hover{background:var(--f-raised,#f3f3f3)}.ds-secondary:focus-visible{outline:2px solid var(--f-accent,#0052d9);outline-offset:5px}"
    },
    {
      "name": "POC 联系字段",
      "kind": "input",
      "refersTo": "input-field",
      "description": "有明确标签与焦点反馈的联系字段。",
      "html": "<div class=\"ds-field\"><label for=\"ds-email\">工作邮箱 <span>*</span></label><input id=\"ds-email\" type=\"email\" placeholder=\"you@company.com\" required /></div>",
      "css": ".ds-field{font-family:\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif;width:280px;max-width:100%;color:var(--f-text,#191919)}.ds-field label{display:block;font-size:13px;line-height:22px;margin-bottom:8px}.ds-field label span{color:var(--f-muted,#666)}.ds-field input{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--f-line,#ddd);border-radius:6px;background:var(--f-bg,#fff);color:var(--f-text,#191919);font:inherit;font-size:14px;outline:none;transition:border-color .15s}.ds-field input:hover{border-color:var(--f-muted,#666)}.ds-field input:focus{border-color:var(--f-accent,#0052d9);outline:2px solid var(--f-accent-soft,#f2f3ff);outline-offset:1px}"
    },
    {
      "name": "产品能力导航",
      "kind": "nav",
      "description": "轻量文字导航，突出当前工作和继续阅读。",
      "html": "<nav class=\"ds-nav\" aria-label=\"产品导航\"><a href=\"#product\">产品能力</a><a href=\"#work\">工作方式</a><a href=\"#docs\">文档</a></nav>",
      "css": ".ds-nav{font-family:\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif;display:flex;align-items:center;gap:30px;font-size:14px}.ds-nav a{padding:12px 0;color:var(--f-muted,#666);text-decoration:none}.ds-nav a:hover{color:var(--f-accent,#0052d9)}.ds-nav a:focus-visible{outline:2px solid var(--f-accent,#0052d9);outline-offset:5px}"
    },
    {
      "name": "待确认状态",
      "kind": "chip",
      "refersTo": "state-chip",
      "description": "产品场景中的待人工确认状态。",
      "html": "<span class=\"ds-chip\"><i></i>待确认</span>",
      "css": ".ds-chip{font-family:\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif;display:inline-flex;align-items:center;gap:5px;padding:2px 6px;border:1px solid color-mix(in srgb,var(--f-accent,#0052d9) 12%,transparent);border-radius:4px;background:var(--f-accent-soft,#f2f3ff);color:var(--f-accent,#0052d9);font-size:10px;white-space:nowrap}.ds-chip i{width:4px;height:4px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "产品报告前景",
      "kind": "card",
      "refersTo": "product-scene",
      "description": "本地产品场景中的报告表面；仅为样式样本。",
      "html": "<section class=\"ds-report\"><small>工作成果 · 本地示例</small><h3>客户反馈改进计划</h3><p>归纳反馈主题，整理改进建议与验收要求。</p><footer>等待团队确认后续行动</footer></section>",
      "css": ".ds-report{font-family:\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif;width:320px;max-width:100%;padding:24px;border:1px solid var(--f-line,#ddd);border-radius:7px;background:var(--f-surface,#fff);color:var(--f-text,#191919)}.ds-report small{font-size:10px;color:var(--f-muted,#666)}.ds-report h3{font-size:21px;line-height:1.4;font-weight:550;letter-spacing:-.4px;margin:6px 0 10px}.ds-report p{font-size:12px;line-height:1.7;color:var(--f-muted,#666)}.ds-report footer{border-top:1px solid var(--f-line,#ddd);padding-top:16px;margin-top:20px;color:var(--f-muted,#666);font-size:10px}"
    },
    {
      "name": "POC 表单外壳",
      "kind": "card",
      "refersTo": "poc-form",
      "description": "联系场景中的克制面板，不使用产品试用叙事。",
      "html": "<section class=\"ds-poc\"><h3>告诉我们您的需求</h3><p>先了解场景，再一起明确 POC 的目标与验收方式。</p></section>",
      "css": ".ds-poc{font-family:\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif;width:360px;max-width:100%;padding:36px;border:1px solid var(--f-line,#ddd);border-radius:12px;background:var(--f-surface,#fff);color:var(--f-text,#191919)}.ds-poc h3{font-size:24px;line-height:1.4;font-weight:500;margin:0 0 12px}.ds-poc p{font-size:13px;line-height:24px;color:var(--f-muted,#666);margin:0}"
    }
  ],
  "narrative": {
    "northStar": "看得见的企业工作能力",
    "overview": "现有视觉以 Linear 式宽幅留白和清楚的阅读层次为基础：左侧标题与右侧说明相互对应，产品场景在其后展开。SkyMythos.ai 的官方标志、TDesign 蓝色与亮暗表面承担品牌身份；页面的视觉重点是工作目标、执行依据与可检查的成果。\n\n官网采用较低的信息密度，产品场景保留更紧凑的工作界面密度。主操作引导访客填写 POC 联系表单，文档与能力说明承担继续了解的入口。场景由 React、CSS 和本地示例状态构成，截图仅作为来源或比较证据，不是页面实现。",
    "keyCharacteristics": [
      "宽幅留白、左对齐标题与说明对照，随后展开产品场景。",
      "SkyMythos.ai 官方亮暗标志与 TDesign 蓝色语义主题。",
      "中性色表面、细边线和轻阴影，按状态使用蓝色、绿色与错误色。",
      "官网阅读与产品界面采用不同密度；手机重排内容。",
      "以联系团队开展 POC 为主要转化，保留可用的键盘和反馈状态。"
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "新增官网和场景表面使用现有 --f-* 语义变量；切换主题时同时更新背景、文字、边线、状态与品牌资产。",
        "section": "colors"
      },
      {
        "name": "The Two Densities Rule",
        "body": "官网用宽间距解释价值，产品场景用紧凑工作面展示状态；不把场景中的微型字号用作正文或表单字号。",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "默认用表面与细边线区分层级，只在导航浮层和产品内部前景使用现有轻阴影。",
        "section": "elevation"
      }
    ],
    "dos": [
