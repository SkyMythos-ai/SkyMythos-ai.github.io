{
  "name": "skymythos-website",
  "version": "1.0.0",
  "private": true,
  "description": "SkyMythos 产品官网 — enterprise private-deployment autonomous software R&D platform",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/product-reference/validate.cjs",
    "build": "next build",
    "start": "node scripts/serve-export.cjs out",
    "lint": "eslint src scripts tests next.config.mjs eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test:commercial": "node scripts/commercial/run.cjs",
    "test:export": "node scripts/check-export.cjs",
    "test:product-reference": "node scripts/product-reference/check.cjs",
    "test:locale-routes": "node scripts/check-locale-routes.cjs",
    "test:fidelity": "node tests/product-fidelity/check.cjs",
    "test:runtime": "node tests/commercial-runtime/check.cjs",
    "install:browser": "python3 -I scripts/commercial/install-browser.py",
    "test:browser-installer": "python3 -I tests/commercial-runtime/browser-install.py",
    "preview": "bash scripts/preview.sh static",
    "local": "bash scripts/preview.sh dev"
  },
  "dependencies": {
    "html-react-parser": "6.1.9",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "lighthouse": "13.5.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
